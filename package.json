{
	"name": "formulalab",
	"version": "0.4.1",
	"description": "Interactive formula visualizer and engineering calculators for Obsidian.",
	"main": "main.js",
	"scripts": {
		"build": "node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"test": "esbuild tests/solvers.test.ts --bundle --platform=node --outfile=dist/solvers.test.cjs --log-level=warning && node dist/solvers.test.cjs",
		"harness": "esbuild dev/harness.ts --bundle --format=iife --outfile=dev/harness.js --log-level=warning && node dev/serve.mjs",
		"check-note": "esbuild tests/validate-note.ts --bundle --platform=node --outfile=dist/validate-note.cjs --log-level=warning --alias:plotly.js-dist-min=./tests/plotly-stub.ts && node dist/validate-note.cjs"
	},
	"keywords": [
		"obsidian",
		"plotly",
		"mathjs",
		"visualization",
		"cfd",
		"navier-stokes",
		"finite-volume",
		"engineering",
		"aerospace"
	],
	"author": "MrQ139",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.30",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.2",
		"obsidian": "^1.5.12",
		"tslib": "^2.6.2",
		"typescript": "^5.4.3"
	},
	"dependencies": {
		"mathjs": "^12.4.1",
		"plotly.js-basic-dist-min": "^2.35.3",
		"yaml": "^2.4.1"
	}
}
